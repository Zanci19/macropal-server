DATABASE_URL=postgresql+psycopg://macropal:YOUR_PASSWORD@localhost:5432/macropal

APP_NAME=MacroPal API
ENVIRONMENT=production

CORS_ORIGINS=*

DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=100

FUZZY_THRESHOLD=0.3

FIREBASE_CREDENTIALS_FILE=/opt/macropal-server/firebase-service-account.json
FIREBASE_CHECK_REVOKED=false
